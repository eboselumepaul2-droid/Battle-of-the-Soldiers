config_version=5

[application]
config/name="Battle of the Soldiers"
config/icon="res://icon.png"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/description="Offline third-person tactical shooter prototype for Android"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.12, 0.17, 0.2, 1)

[input]
move_forward={"deadzone":0.2,"events":[{"physical_keycode":87,"unicode":119}]}
move_back={"deadzone":0.2,"events":[{"physical_keycode":83,"unicode":115}]}
move_left={"deadzone":0.2,"events":[{"physical_keycode":65,"unicode":97}]}
move_right={"deadzone":0.2,"events":[{"physical_keycode":68,"unicode":100}]}
sprint={"deadzone":0.2,"events":[{"physical_keycode":4194325}]}
jump={"deadzone":0.2,"events":[{"physical_keycode":32}]}
fire={"deadzone":0.2,"events":[{"physical_keycode":70,"unicode":102}]}

[display/window]
size/resizable=true
